# URL nội bộ Docker Swarm (Server Component fetch — container-to-container)
# Dùng tên service Docker thay vì localhost
API_BASE_URL=http://car-admin:4000

# URL công khai (Client Component fetch — chạy trong browser người dùng)
# Phải là IP/domain có thể truy cập từ bên ngoài VPS
NEXT_PUBLIC_API_URL=http://192.168.247.130:4000
